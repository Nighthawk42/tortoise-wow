TORTOISE_SIDECAR_CONFIG_DIR=config
TORTOISE_SIDECAR_SERVER_ID=turtle-dev
TORTOISE_SIDECAR_PROVIDER=mock
# Set a long random value outside source control to require bearer authentication.
TORTOISE_SIDECAR_SERVICE_TOKEN=

